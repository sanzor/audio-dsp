{
  "title": "API Health & Throughput",
  "uid": "api-health",
  "editable": true,
  "refresh": "5s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Total Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (statuscode) (rate(scoring_service_response_code[$__rate_interval]))",
          "legendFormat": "Status: {{statuscode}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "title": "Success Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(sum(rate(scoring_service_response_code{statuscode=~\"2..\"}[$__rate_interval])) / clamp_min(sum(rate(scoring_service_response_code[$__rate_interval])), 1)) * 100"
        }
      ]
    },
    {
      "id": 25,
      "title": "Latency Percentiles (p50, p90, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(scoring_service_response_time_bucket[$__rate_interval])))",
          "legendFormat": "p99 (Worst Case)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scoring_service_response_time_bucket[$__rate_interval])))",
          "legendFormat": "p95 (High)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(scoring_service_response_time_bucket[$__rate_interval])))",
          "legendFormat": "p90 (Slow)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(scoring_service_response_time_bucket[$__rate_interval])))",
          "legendFormat": "p50 (Median)"
        }
      ],
      "fieldConfig": {
        "defaults": { 
          "unit": "s", 
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } 
        }
      }
    },
    {
      "id": 3,
      "title": "5xx Error Spikes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 30 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(scoring_service_response_code{statuscode=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Server Crashes/Errors"
        }
      ]
    },

    {
      "id": 20,
      "title": "Rate Limiter Verdicts (Allowed vs Denied) (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(rate_limiter_hot_path_total[$__rate_interval])) by (verdict)",
          "legendFormat": "{{verdict}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 21,
      "title": "Rate Limiter Denied (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "100 * sum(rate(rate_limiter_hot_path_total{verdict=\"denied\"}[$__rate_interval])) / clamp_min(sum(rate(rate_limiter_hot_path_total[$__rate_interval])), 1)"
        }
      ]
    },
    {
      "id": 22,
      "title": "Refill Send Drops (Full / Closed) (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 26 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(rate_limiter_refill_send_total{outcome=~\"dropped_.*\"}[$__rate_interval])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },

    {
      "id": 30,
      "title": "Event Send Drops (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(api_event_send_total{outcome=~\"dropped_.*\"}[$__rate_interval])) by (stream)",
          "legendFormat": "{{stream}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 31,
      "title": "Buffered Consume Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(api_event_consume_total[$__rate_interval])) by (stream)",
          "legendFormat": "{{stream}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 32,
      "title": "Flush Errors (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(api_event_flush_total{status=\"error\"}[$__rate_interval])) by (stream)",
          "legendFormat": "{{stream}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 33,
      "title": "Avg Flush Batch Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(api_event_flush_batch_size_total[$__rate_interval])) by (stream) / clamp_min(sum(rate(api_event_flush_total{status=\"success\"}[$__rate_interval])) by (stream), 1)",
          "legendFormat": "{{stream}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },

    {
      "id": 4,
      "title": "Live API Logs (Filtered for Health)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 82 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{service=\"scoring-api\"}"
        }
      ]
    },
    {
      "id": 40,
      "title": "Redis Commands/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(redis_commands_processed_total[$__rate_interval]))",
          "legendFormat": "commands/sec"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "id": 41,
      "title": "Redis Connected Clients",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(redis_connected_clients)",
          "legendFormat": "clients"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 }
      }
    },
    {
      "id": 42,
      "title": "Redis Memory Used vs Max",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(redis_memory_used_bytes)",
          "legendFormat": "used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(redis_memory_max_bytes)",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 43,
      "title": "Redis Hit Ratio (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "100 * sum(rate(redis_keyspace_hits_total[$__rate_interval])) / clamp_min(sum(rate(redis_keyspace_hits_total[$__rate_interval])) + sum(rate(redis_keyspace_misses_total[$__rate_interval])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "id": 44,
      "title": "Redis Evicted vs Expired Keys (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 66 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(redis_evicted_keys_total[$__rate_interval]))",
          "legendFormat": "evicted/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(redis_expired_keys_total[$__rate_interval]))",
          "legendFormat": "expired/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 }
      }
    },
    {
      "id": 45,
      "title": "Redis Blocked Clients",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 74 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(redis_blocked_clients)",
          "legendFormat": "blocked"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 }
      }
    },
    {
      "id": 46,
      "title": "Redis Stream Commands/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 74 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (cmd) (rate(redis_commands_total{cmd=~\"xadd|xread|xreadgroup|xack|xclaim|xdel|xtrim\"}[$__rate_interval]))",
          "legendFormat": "{{cmd}}/sec"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "query": "1s,5s,15s,1m,5m,15m,1h",
        "auto": true
      }
    ]
  }
}
