## Local overrides for the API (loaded by backend/api/src/main.rs).
## Copy to backend/api/.env (this file is gitignored) and adjust as needed.
##
## If you use the repo's compose stack (Makefile + yml/postgres.yml defaults):
## - Host: 127.0.0.1
## - Port: 5433
## - User/pass: postgres/postgres
## - DB: audio_dsp
##
## If you already have Postgres running on 5432, change the port (and password).

RUST_LOG=debug
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/audio_dsp
