{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database: up-db",
      "type": "shell",
      "command": "make up-db",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "database",
        "clear": true
      }
    },
    {
      "label": "Backend: cargo build api",
      "type": "shell",
      "command": "cargo build -p api",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": ["Database: up-db"],
      "dependsOrder": "sequence",
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "Backend: cargo run api",
      "type": "shell",
      "command": "cargo run -p api",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": ["Database: up-db"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "backend",
        "pattern": [
          {
            "regexp": "^(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(\\s*)(Compiling|Finished|Running)\\b",
          "endsPattern": "^(\\s*)Server running at http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend",
        "clear": true
      }
    },
    {
      "label": "Frontend: pnpm dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [
          {
            "regexp": "^(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(\\s*)VITE\\s+v\\d+",
          "endsPattern": "^(\\s*)Local:\\s+http://localhost:3000/?"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Dev: backend + frontend (terminals)",
      "dependsOn": ["Backend: cargo run api", "Frontend: pnpm dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
