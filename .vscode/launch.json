{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust: Debug API",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/backend/target/debug/api",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "sourceLanguages": ["rust"],
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "Backend: cargo build api"
    },
    {
      "name": "Rust: Debug API (console fallback)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/backend/target/debug/api",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "sourceLanguages": ["rust"],
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "Backend: cargo build api"
    },
    {
      "name": "Frontend: Vite (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Frontend: pnpm dev"
    },
    {
      "name": "Frontend: Chrome (no task)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Rust: Attach API (pick pid)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/backend/target/debug/api",
      "pid": "${command:pickMyProcess}",
      "preLaunchTask": "Dev: backend + frontend (terminals)"
    },
    {
      "name": "Dev: Backend + Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Dev: backend + frontend (terminals)"
    }
  ],
  "compounds": [
    {
      "name": "Dev: Backend + Frontend (debug attach)",
      "configurations": ["Rust: Attach API (pick pid)", "Frontend: Chrome (no task)"],
      "stopAll": true
    }
  ]
}
