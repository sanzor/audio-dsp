{
  "version": "0.2.0",
  "configurations": [

    // --- RUST ---
    {
      "name": "Rust: Debug API",
      "type": "lldb",
      "request": "launch",
      "presentation": { "group": "1_Rust", "order": 1 },
      "program": "${workspaceFolder}/backend/target/debug/api",
      "cwd": "${workspaceFolder}/backend/api",
      "preLaunchTask": "Backend: cargo build api",
      "sourceLanguages": ["rust"],
      "env": {
        "RUST_LOG": "debug",
        "APP_ENV": "dev",
        "APP_CONFIG_PATH": "${workspaceFolder}/backend/api"
      },
      "initCommands": [
        "settings set target.inline-breakpoint-strategy always",
        "settings set target.source-map . ${workspaceFolder}",
        "settings set target.process.thread.step-avoid-regexp \\.(cargo|rustup)/"
      ]
    },

    // --- FRONTEND ---
    {
      "name": "Frontend: Vite Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "presentation": { "group": "4_UI", "order": 1 },
      "command": "cd ${workspaceFolder}/frontend && export NVM_DIR=\"$HOME/.nvm\"; [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\"; pnpm dev",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Local:.*http://localhost:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "webRoot": "${workspaceFolder}/frontend"
      }
    },
    {
      "name": "Frontend: Chrome (attach)",
      "type": "pwa-chrome",
      "request": "launch",
      "presentation": { "group": "4_UI", "order": 2 },
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend"
    },

    // --- UTILITIES ---
    {
      "name": "Attach to Process",
      "type": "lldb",
      "request": "attach",
      "presentation": { "group": "3_Utils", "order": 1 },
      "pid": "${command:pickMyProcess}",
      "initCommands": [
        "settings set target.source-map . ${workspaceFolder}"
      ]
    }

  ],
  "compounds": [
    {
      "name": "🚀 Backend + Frontend",
      "configurations": ["Rust: Debug API", "Frontend: Vite Dev Server"],
      "presentation": { "group": "0_All", "order": 1 },
      "stopAll": true
    }
  ]
}
